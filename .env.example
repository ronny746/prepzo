MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.j2rh7ux.mongodb.net/prepzo
PORT=3000
# Required in production (server refuses to start without it). Use a long random value.
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development
# Dev/staging only: fixed email OTP for testing without SMTP. Ignored when NODE_ENV=production.
STATIC_OTP=
# Temporary: set to true to honour STATIC_OTP even with NODE_ENV=production
# (servers without SMTP). Anyone knowing an admin email can then sign in.
ALLOW_STATIC_OTP_IN_PRODUCTION=
RECORDINGS_DIR=./recordings
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

PAYMENT_GATEWAY=RAZORPAY

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
AWS_S3_BUCKET=lms-media-storage-2026

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Zoom Configuration
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# SMTP Configuration (Optional for email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Server-side paper import from bank.theprepzo.com
PREPZO_IMPORT_SHARED_SECRET=
PREPZO_IMPORT_INSTITUTE_ID=
PREPZO_IMPORT_CREATED_BY=

# SMS OTP provider (BulkSenders). Required for mobile OTP login.
SMS_API_KEY=

# Developer mode (hard-delete tools). Leave both empty to disable.
DEVELOPER_PIN=
DEVELOPER_EMAIL=
